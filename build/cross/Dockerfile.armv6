# syntax=docker/dockerfile:1
# One-KVM ARMv6 build environment (Raspberry Pi Zero / Zero W / Pi 1, Raspberry Pi OS 13 "trixie")
#
# A linux/arm/v6 Raspbian image with gcc, Rust and the libraries One-KVM
# needs. It runs natively on an arm64 host that can execute 32-bit ARM code
# (GitHub's ubuntu-24.04-arm runners, Oracle Cloud Ampere A1, Pi 4/400 on a
# 64-bit OS): no cross compiler, no QEMU, and the compilers produce ARMv6
# code by default. On hosts without a 32-bit ARM mode (Graviton 3+, x86) the
# same image runs under QEMU user emulation: same result, much slower.
#
#   docker build --platform linux/arm/v6 -t onekvm-armv6 -f build/cross/Dockerfile.armv6 build/cross
#   docker run --rm -it --platform linux/arm/v6 -v "$PWD":/src onekvm-armv6
#     (in the container: cargo build --release)
#
# Base: tianon/raspbian, a minimal Raspbian image built from the Raspbian
# archive by Tianon Gravi (maintainer of Docker's official Debian images).
# It is arm/v6-only; the platform comes from docker build --platform.
FROM tianon/raspbian:trixie-slim

ARG FFMPEG_VERSION=n7.1.1
ARG LIBJPEG_TURBO_VERSION=3.1.4.1
ARG LIBYUV_REV=957f295ea946cbbd13fcfc46e7066f2efa801233
ARG RUSTUP_TIMEOUT=30m

# Compilers and -dev packages. No FFmpeg from Raspbian: its libavcodec pulls
# in VAAPI, VDPAU, x264, x265, dav1d, ... on the Pi; a minimal one is built
# below. No curl or git: sources and rustup-init are fetched with ADD.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential pkg-config cmake ca-certificates xz-utils util-linux \
        clang libclang-dev \
        libasound2-dev libudev-dev libdrm-dev libopus-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# On a 64-bit kernel uname reports "aarch64" even to 32-bit programs, which
# misleads cmake/configure. linux32 makes it report a 32-bit ARM machine
# (armv8l); the code built is still ARMv6, as the compilers default to it.
# Under QEMU uname already says armv7l, and linux32 itself fails on CPUs
# without 32-bit support (personality(PER_LINUX32) -> EINVAL), so arm32
# uses linux32 only where it works.
RUN printf '%s\n' '#!/bin/sh' \
        'if linux32 true 2>/dev/null; then exec linux32 "$@"; fi' \
        'exec "$@"' > /usr/local/bin/arm32 \
    && chmod 755 /usr/local/bin/arm32
SHELL ["/usr/local/bin/arm32", "/bin/bash", "-euo", "pipefail", "-c"]
ENTRYPOINT ["/usr/local/bin/arm32"]

# time_t: everything built here uses glibc's default 32-bit time_t, like the
# Rust ecosystem does on 32-bit ARM (libc crate, nix, socket2, v4l2r...).
# Forcing 64-bit time_t only in parts of the build makes them disagree with
# each other (E0308 in socket2, v4l2r). Raspbian trixie's own libraries use
# 64-bit time_t, but glibc keeps the 32-bit functions and One-KVM passes no
# time_t structs to those libraries (its ALSA calls use no timestamps; V4L2
# goes straight to the kernel, which accepts both layouts).
ENV LANG=C.UTF-8 \
    PATH=/root/.cargo/bin:$PATH

# Minimal static FFmpeg: libavcodec + libavutil with only the V4L2 M2M H.264
# encoder (the Pi's bcm2835-codec). --disable-autodetect keeps out VAAPI,
# VDPAU, DRM, zlib, ...; the result needs nothing but libc/libm/libatomic.
# One-KVM's other encoders (HEVC, VP8/9, VAAPI, x264) then just fail its
# runtime probe. LGPL build, no NEON (ARMv6 has none).
ADD https://github.com/FFmpeg/FFmpeg.git#${FFMPEG_VERSION} /tmp/ffmpeg
RUN cd /tmp/ffmpeg \
    && ./configure --prefix=/opt/ffmpeg \
        --arch=arm --cpu=arm1176jzf-s --disable-neon --disable-vfpv3 --disable-armv6t2 \
        --enable-static --disable-shared --enable-pic \
        --disable-programs --disable-doc --disable-debug --disable-network \
        --disable-autodetect --disable-everything \
        --disable-avformat --disable-avdevice --disable-avfilter \
        --disable-swscale --disable-swresample \
        --enable-v4l2-m2m --enable-encoder=h264_v4l2m2m \
    && grep -q 'CONFIG_H264_V4L2M2M_ENCODER 1' config_components.h \
    && make -j"$(nproc)" install \
    && rm -rf /tmp/ffmpeg

# libjpeg-turbo 3.x (One-KVM needs the TurboJPEG 3 API; Raspbian has 2.1).
# No SIMD: its 32-bit ARM SIMD code is NEON, which ARMv6 doesn't have.
ADD https://github.com/libjpeg-turbo/libjpeg-turbo.git#${LIBJPEG_TURBO_VERSION} /tmp/jpeg
RUN cmake -S /tmp/jpeg -B /tmp/jpeg/build -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DENABLE_SHARED=OFF -DENABLE_STATIC=ON -DWITH_SIMD=OFF \
    && make -C /tmp/jpeg/build -j"$(nproc)" install \
    && rm -rf /tmp/jpeg

# libyuv at the revision upstream One-KVM uses (NEON paths compiled out).
# Raspbian's own libyuv is too old (no RGB24ToNV12).
ADD https://github.com/lemenkov/libyuv.git#${LIBYUV_REV} /tmp/yuv
RUN cd /tmp/yuv \
    && cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DJPEG_INCLUDE_DIR=/usr/local/include -DJPEG_LIBRARY=/usr/local/lib/libjpeg.a \
        -DCMAKE_C_FLAGS="-DHAVE_JPEG -DLIBYUV_DISABLE_NEON" \
        -DCMAKE_CXX_FLAGS="-DHAVE_JPEG -DLIBYUV_DISABLE_NEON" \
    && make -C build -j"$(nproc)" install \
    && rm -rf /tmp/yuv

# Rust with an ARMv6 host toolchain. Last of the build steps: Docker
# re-checks the URL on each build, so a new rustup-init release only re-runs
# this step. A stalled attempt is killed after RUSTUP_TIMEOUT (unpacking is
# slow under QEMU) and retried, up to 3 times.
ADD --chmod=755 https://static.rust-lang.org/rustup/dist/arm-unknown-linux-gnueabihf/rustup-init /tmp/rustup-init
RUN for i in 1 2 3; do \
        timeout "$RUSTUP_TIMEOUT" /tmp/rustup-init -y -v --profile minimal \
            --default-host arm-unknown-linux-gnueabihf && break; \
        echo "rustup-init attempt $i failed or stalled"; \
        [ "$i" = 3 ] && exit 1; sleep 5; \
    done \
    && rm /tmp/rustup-init \
    && rustc --version && cargo --version

# The C libraries built above are used as they are, so cargo doesn't compile
# them again:
# FFMPEG_STATIC + PKG_CONFIG_PATH: hwcodec links the minimal FFmpeg
# statically (via pkg-config). ONE_KVM_LIBS_PATH: libyuv is found here.
# TURBOJPEG_*: the turbojpeg crate links /usr/local/lib/libturbojpeg.a
# instead of building its bundled libjpeg-turbo with cmake.
# Thin LTO: rustc is a 32-bit program here (max 4 GB address space), and
# One-KVM's default full LTO with one codegen unit may not fit.
# --allow-multiple-definition: libjpeg.a (for libyuv) and libturbojpeg.a
# both contain the libjpeg functions; upstream One-KVM links with it too.
ENV PKG_CONFIG_PATH=/opt/ffmpeg/lib/pkgconfig \
    FFMPEG_STATIC=1 \
    ONE_KVM_LIBS_PATH=/usr/local \
    LIBYUV_STATIC=1 \
    TURBOJPEG_SOURCE=explicit \
    TURBOJPEG_STATIC=1 \
    TURBOJPEG_LIB_DIR=/usr/local/lib \
    TURBOJPEG_INCLUDE_DIR=/usr/local/include \
    CARGO_PROFILE_RELEASE_LTO=thin \
    RUSTFLAGS="-C link-arg=-Wl,--allow-multiple-definition"

ARG SOURCE_URL=https://github.com/ruitaodong/One-KVM-armv6l
LABEL org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.description="One-KVM ARMv6 build environment (Raspberry Pi OS trixie armhf: gcc, Rust, minimal FFmpeg with h264_v4l2m2m, libjpeg-turbo 3, libyuv)"

WORKDIR /src
CMD ["bash"]
