# syntax=docker/dockerfile:1
FROM vascoguita/raspios:armhf-trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install --yes --no-install-recommends \
    libavcodec-dev \
    libavdevice-dev \
    libavfilter-dev \
    libavformat-dev \
    libavutil-dev \
    libasound2-dev \
    libopus-dev \
    libssl-dev \
    libswresample-dev \
    libswscale-dev \
    libturbojpeg0-dev \
    libudev-dev \
    libv4l-dev \
    libyuv-dev \
    && rm --recursive --force /var/lib/apt/lists/*